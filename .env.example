# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git: secrets never go to GitHub.
# Anything starting with NEXT_PUBLIC_ is visible in the browser — never put a secret there.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Task 1) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET: server only. Never paste it in chat, GitHub or any NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Product photos (Task 13): leave empty until the photos are uploaded; then set to 1
NEXT_PUBLIC_PRODUCT_PHOTOS=

# Razorpay test mode (Task 9)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Upstash rate limiting (Task 8)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Task 8)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email (Task 9)
RESEND_API_KEY=

# Sentry (Stage 5)
SENTRY_DSN=
