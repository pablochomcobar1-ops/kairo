# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git: secrets never go to GitHub.
# Anything starting with NEXT_PUBLIC_ is visible in the browser — never put a secret there.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Task 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test mode (Task 9)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Upstash rate limiting (Task 8)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Task 8)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email (Task 9)
RESEND_API_KEY=

# Sentry (Stage 5)
SENTRY_DSN=
