# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git: secrets never go to GitHub.
# Anything starting with NEXT_PUBLIC_ is visible in the browser — never put a secret there.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Task 1) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET: server only. Never paste it in chat, GitHub or any NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Product photos (Task 13): leave empty until the photos are uploaded; then set to 1
NEXT_PUBLIC_PRODUCT_PHOTOS=

# Razorpay test mode (Task 9) — Dashboard (Test Mode) → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SECRET: server only.
RAZORPAY_KEY_SECRET=
# Set when the webhook is created after launch (Stage 7): Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Upstash rate limiting (Task 8) — Upstash console → your database → REST API
# Without these: counts are kept in memory on your PC (npm run dev); in production the forms switch off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Task 8) — Cloudflare dashboard → Turnstile → your widget
# Without these: the check is skipped on your PC; in production sign-up is refused.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email (Task 9) — optional; without it orders work, emails are skipped
RESEND_API_KEY=
# Sender; leave empty for Resend's test sender (delivers only to your own Resend email)
EMAIL_FROM=

# Sentry (Stage 5)
SENTRY_DSN=
